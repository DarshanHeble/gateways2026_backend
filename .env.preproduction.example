# Environment Baseline Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000
REGISTRATION_CONSOLE_URL=http://localhost:3002
ENTRY_PASS_AMOUNT_INR=250

# Database Configuration (Individual Fields OR Connection URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=gateways2026_db

# Security Secrets (Generate using openssl rand -base64 32 in production)
AUTH_SECRET=development_auth_secret_must_be_changed_in_production_min_32_chars
CHECKIN_TOKEN_SECRET=development_checkin_secret_must_be_changed_in_prod_min32

# CORS Config (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ==========================================
# Primary SMTP Credentials (Main Provider)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=primary@example.com
SMTP_PASS=primarypassword
SMTP_FROM="Gateways 2026 <primary@example.com>"

# ==========================================
# Fallback SMTP Credentials (Backup Provider)
# ==========================================
SMTP_FALLBACK_HOST=smtp.sendgrid.net
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_USER=fallback@example.com
SMTP_FALLBACK_PASS=fallbackpassword
SMTP_FALLBACK_FROM="Gateways 2026 Backup <fallback@example.com>"

# ==========================================
# CLOUDINARY Credentials
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secretL

# Password reset links
PASSWORD_RESET_EXPIRY_MINUTES=30

# Vercel project slug for the admin dashboard, enabling CORS for its preview
# deploys only (never in production). Leave unset to disable preview access.
CORS_VERCEL_PROJECT=

# --- Mail relay (production) -------------------------------------------------
# Render and most PaaS block outbound SMTP (25/465/587), so nodemailer can never
# deliver from there. An HTTPS POST on 443 always gets out. Set these in
# production; leave them blank locally and SMTP below is used instead.
#
# The relay receives { to, email, from, subject, html, text, otp? } — a superset,
# so a PHP script written against the older { email, otp } contract still works
# for verification codes, while a generic one can also send the password-reset
# LINK (which contains no code).
PHP_MAILER_URL=
PHP_MAILER_API_KEY=
