# Preproduction Environment Configuration
NODE_ENV=preproduction
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000

# Preproduction Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=gateways2026_preprod_db

# Alternative: Single Connection URL
# DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3306/gateways2026_preprod_db

# Security Secrets
AUTH_SECRET=preproduction_auth_secret_must_be_changed_min_32_chars
CHECKIN_TOKEN_SECRET=preproduction_checkin_secret_must_be_changed_min32

# CORS Config
CORS_ORIGIN=http://localhost:3000

# Optional Integrations — Mail (Primary & Fallback SMTP)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=primary@example.com
# SMTP_PASS=primarypassword

# SMTP_FALLBACK_URL=smtps://fallbackuser:fallbackpass@smtp-fallback.example.com:465
# SMTP_FALLBACK_HOST=smtp.sendgrid.net
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=fallback@example.com
# SMTP_FALLBACK_PASS=fallbackpassword
# SMTP_FALLBACK_FROM="Gateways 2026 Backup <no-reply@gateways2026.com>"

