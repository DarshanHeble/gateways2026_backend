# Production Environment Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=https://api.gateways2026.com

# Production Database Pools
DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3306/gateways2026_prod_db
WRITER_DATABASE_URL=mysql://writer_user:writer_password@127.0.0.1:3306/gateways2026_prod_db

# Security Secrets
AUTH_SECRET=production_auth_secret_must_be_changed_min_32_chars
CHECKIN_TOKEN_SECRET=production_checkin_secret_must_be_changed_min32

# CORS Config
CORS_ORIGIN=https://gateways2026.com
