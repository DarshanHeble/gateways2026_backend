# Environment Baseline Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000

# Database Configuration (Individual Fields OR Connection URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=gateways2026_db

# Alternative: Single Connection URL
# DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3306/gateways2026_db

# Security Secrets (Generate using openssl rand -base64 32 in production)
AUTH_SECRET=development_auth_secret_must_be_changed_in_production_min_32_chars
CHECKIN_TOKEN_SECRET=development_checkin_secret_must_be_changed_in_prod_min32

# CORS Config (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Optional Integrations — Mail (Primary & Fallback SMTP)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=primary@example.com
# SMTP_PASS=primarypassword
# SMTP_FROM="Gateways 2026 <no-reply@gateways2026.com>"

# SMTP_FALLBACK_URL=smtps://fallbackuser:fallbackpass@smtp-fallback.example.com:465
# SMTP_FALLBACK_HOST=smtp.sendgrid.net
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=fallback@example.com
# SMTP_FALLBACK_PASS=fallbackpassword
# SMTP_FALLBACK_FROM="Gateways 2026 Backup <no-reply@gateways2026.com>"

# STORAGE_BUCKET_URL=https://storage.googleapis.com/gateways-receipts

# ─── Google Sheets Integration ────────────────────────────────────────────────
# Required when Storage Strategy = Sheets as source of truth.
# GOOGLE_SERVICE_EMAIL is the client_email from your service account JSON key.
# GOOGLE_PRIVATE_KEY is the private_key field — paste it with literal \n characters.
# SHEET_ID is the long alphanumeric ID in the Google Sheets URL.
GOOGLE_SERVICE_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...your_key_here...\n-----END RSA PRIVATE KEY-----"
SHEET_ID=your_google_sheet_id_here

# ─── Webhook Security ─────────────────────────────────────────────────────────
# Shared secret for POST /api/webhook/sheet-update.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SHEET_WEBHOOK_SECRET=generate_a_random_secret_at_least_32_characters_long
