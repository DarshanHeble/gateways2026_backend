# Environment Baseline Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000

# Database Configuration (Individual Fields OR Connection URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=gateways2026_db

# Alternative: Single Connection URL
# DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3306/gateways2026_db

# Security Secrets (Generate using openssl rand -base64 32 in production)
AUTH_SECRET=development_auth_secret_must_be_changed_in_production_min_32_chars
CHECKIN_TOKEN_SECRET=development_checkin_secret_must_be_changed_in_prod_min32

# CORS Config (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Optional Integrations
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# STORAGE_BUCKET_URL=https://storage.googleapis.com/gateways-receipts
